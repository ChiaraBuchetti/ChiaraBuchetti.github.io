source "https://rubygems.org"

# Stesso ambiente usato da GitHub Pages: ciò che funziona in locale
# funziona anche online. La versione minima evita che bundler scelga
# versioni vecchie (Jekyll 3.6) incompatibili con Ruby 3.x.
gem "github-pages", ">= 232", group: :jekyll_plugins

# Librerie rimosse dalla libreria standard di Ruby 3.x
gem "webrick", "~> 1.8"
gem "rexml"
gem "csv"
gem "base64"
gem "bigdecimal"
gem "logger"
